# DEV CONSTRUCTIONS — Frontend Environment Variables
# Copy this to .env and fill in real values.
# Do NOT commit .env to git.

# For local development (Vite mock API):
# Leave empty or omit — defaults to '' (same-origin)
VITE_API_URL=

# For production (point to your deployed Express backend):
# VITE_API_URL=https://your-backend.railway.app

# Dev admin credentials (used by Vite mock API ONLY — never exposed to browser)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_local_dev_password_here
