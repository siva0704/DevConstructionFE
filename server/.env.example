# DEV CONSTRUCTIONS — Server Environment Variables
# ================================================
# Copy this to .env and fill in real values.
# NEVER commit .env to git!

NODE_ENV=production
PORT=4000

# Admin credentials (generate with: node setup-credentials.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH

# Random 64-byte hex cookie signing secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET

# Your deployed frontend URL (for CORS)
FRONTEND_ORIGIN=http://localhost:5173
